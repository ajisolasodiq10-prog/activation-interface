# Base URL of the independently deployed Account Management Backend, e.g. http://localhost:5100
# (or http://localhost:5100/api/v1: "/api/v1" is added automatically when missing). No trailing slash.
# Vite variables are PUBLIC in the browser. Never put secrets or API keys here.
VITE_ACCOUNT_API_BASE_URL=

# Full URL of the School Management Frontend's login page. Shown as a link after success.
VITE_SCHOOL_LOGIN_URL=

# Optional: school name shown in the page header.
VITE_SCHOOL_NAME=
